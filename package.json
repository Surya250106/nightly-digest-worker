{
  "name": "nightly-digest-worker",
  "version": "1.0.0",
  "description": "Asynchronous nightly digest worker with activity logging, BullMQ, Redis, PostgreSQL, and Express",
  "main": "src/api/server.js",
  "scripts": {
    "start": "node src/api/server.js",
    "start:api": "node src/api/server.js",
    "start:worker": "node src/worker/index.js",
    "start:scheduler": "node src/scheduler/index.js",
    "migrate": "node src/db/migrate.js",
    "test": "jest --runInBand --detectOpenHandles --forceExit",
    "test:coverage": "jest --coverage --runInBand --detectOpenHandles --forceExit"
  },
  "dependencies": {
    "bullmq": "^5.41.0",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "ioredis": "^5.5.0",
    "node-cron": "^3.0.3",
    "pg": "^8.13.3"
  },
  "devDependencies": {
    "jest": "^29.7.0",
    "supertest": "^7.0.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
